# ic14_continuous_quad.lgi
# interpolate / continuous of the LINEAR field flin = 1 + 2x - 3y +
# 0.5z from a 2D quad mesh (6 x 6 quads). LaGriT splits each quad into
# 4 triangles about its centre and interpolates linearly in them, so a
# linear field is exact.
# check: linear | out_ic14.inp | fc
read / avs / src_quad.inp / mo_src
read / avs / sink2d_points.inp / mo_snk
cmo / addatt / mo_snk / fc / VDOUBLE / scalar / nnodes
interpolate / continuous / mo_snk fc / 1,0,0 / mo_src flin
dump / avs / out_ic14.inp / mo_snk
finish
