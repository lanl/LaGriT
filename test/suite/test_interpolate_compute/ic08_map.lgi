# ic08_map.lgi
# interpolate / map of a CELL attribute: each sink tet takes the value
# of the source hex that contains its centroid. Source: 4 x 4 x 4 hexes
# with cval = 1 + i + 10 j + 100 k; sink: the tet mesh squeezed into
# the box by a different amount per axis, so no centroid lies on a face.
# check: map | out_ic08.inp | cv | src_hex.inp
read / avs / src_hex.inp / mo_src
read / avs / sink_tet_sq.inp / mo_snk
cmo / addatt / mo_snk / cv / VDOUBLE / scalar / nelements
interpolate / map / mo_snk cv / 1,0,0 / mo_src cval
dump / avs / out_ic08.inp / mo_snk
finish
