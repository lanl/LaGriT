# ic03_voronoi_keepatt_dudded.lgi
# ic02 with a DUDDED sink vertex (itp 21, vertex 50), which interpolate
# skips. Regression test (Jeffrey Hyman, Oct 20 2026): the stored lookup
# was read by list position instead of vertex number, so every vertex
# after the dudded one got its neighbour's value. fa and fb must be the
# nearest value at every vertex but the dudded one.
# check: voronoi | out_ic03.inp | fa,fb | fsrc | skip_itp21
read / avs / src_points.inp / mo_src
read / avs / src_tet.inp / mo_snk
cmo / setatt / mo_snk / itp / 50,50,1 / 21
cmo / addatt / mo_snk / xa / VDOUBLE / scalar / nnodes
cmo / addatt / mo_snk / fa / VDOUBLE / scalar / nnodes
cmo / addatt / mo_snk / fb / VDOUBLE / scalar / nnodes
interpolate / voronoi / mo_snk xa / 1,0,0 / mo_src xic / keepatt
interpolate / voronoi / mo_snk fa / 1,0,0 / mo_src fsrc
cmo / DELATT / mo_snk / pt_gtg
interpolate / voronoi / mo_snk fb / 1,0,0 / mo_src fsrc
dump / avs / out_ic03.inp / mo_snk
finish
