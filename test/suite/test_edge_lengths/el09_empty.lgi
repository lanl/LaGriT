#####################################################################
# el09_empty.lgi
#
# A mesh object with no nodes, and one with nodes but no cells: an
# ERROR (it crashed before, parking lot 89), LaGriT goes on; then a
# valid call works.
#
# refused : ERROR cmo/addatt/edge_lengths_mean: the mesh object has no
# refused : ERROR cmo/addatt/edge_connections: the mesh object has no
# refused : ERROR cmo/addatt/edge_lengths_max: the mesh object has no
# refused : cells (edges are needed): mo_pts; attribute not filled.
# check : el09_out.inp
#####################################################################
cmo / create / mo_empty
cmo / addatt / mo_empty / edge_lengths_mean / el_mean
cmo / addatt / mo_empty / edge_connections / nedge
cmo / create / mo_pts
createpts / xyz / 3 3 1 / 0. 0. 0. / 1. 1. 0. / 1 1 1
cmo / addatt / mo_pts / edge_lengths_max / el_max
read / avs / el_equi.inp / mo
cmo / addatt / mo / edge_lengths_min / el_min
cmo / addatt / mo / edge_lengths_max / el_max
cmo / addatt / mo / edge_lengths_mean / el_mean
dump / avs / el09_out.inp / mo
finish
