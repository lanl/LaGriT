# po01_point_source.lgi -- test_poisson_octree (see 00README)
# graded h from a point source; also writes the octree leaves
cmo / create / mo_src / / / tet
createpts / xyz / 1 1 1 / 0.3 0.6 0.45 / 0.3 0.6 0.45 / 1 1 1
define / POI_XMIN / 0.0
define / POI_YMIN / 0.0
define / POI_ZMIN / 0.0
define / POI_XMAX / 1.0
define / POI_YMAX / 1.0
define / POI_ZMAX / 1.0
define / IF_POI_EDGE_BUFFER / 0
define / POI_EDGE_BUFFER / 1.0
createpts / poisson_disk / 3d_box / mo_pts / 0.02 / connect / &
      h_point.mlgi / h_lookup octree / octree_dump po01_octree.inp / &
      poisson_seed 1
dump / avs / po01_points.inp / mo_pts / 1 0 0 0
quality
cmo / addatt / mo_pts / ang_mind / ang_min
cmo / addatt / mo_pts / ang_maxd / ang_max
dump / avs / po01_angles.table / mo_pts / 0 0 0 1
finish
