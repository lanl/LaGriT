#####################################################################
# p2d06_circle_h0p025.lgi
#
# polygon : circle_r1.poly
# h       : 0.025
# expect  : valid
#
# EXPECT:
#   No ERROR, no WARNING (convex polygon). Every raw point inside
#   the polygon. No inverted elements.
#
# NOTE:
#   Unit circle, radius 1, as a 64 vertex polygon. Edges are
#   about 4h long (0.098), so the sampler chooses most boundary
#   points itself, between the polygon vertices, rather than
#   having them fixed by the outline. Every vertex is a gently
#   convex corner (174.4 deg). About pi/h^2 = 5000 points.
#
#   The sampler runs TWICE. The first run, with no_connect, gives
#   the raw points used for spacing, containment and count. The
#   second, with connect, gives the mesh used for element quality.
#   The connected mesh cannot be used for spacing: it has been
#   smoothed, and recon 1 has added boundary nodes.
#####################################################################
read / avs / circle_r1.poly / mo_polygon
#
# raw sampler points
#
cmo / select / mo_polygon
createpts / poisson_disk / 2d_polygon / mo_raw / mo_polygon &
      / 0.025 / no_connect
dump / avs / raw_p2d06_circle_h0p025.inp / mo_raw
cmo / delete / mo_raw
#
# connected mesh
#
cmo / select / mo_polygon
createpts / poisson_disk / 2d_polygon / mo_pts / mo_polygon &
      / 0.025 / connect
cmo / select / mo_pts
quality
dump / avs / out_p2d06_circle_h0p025.inp / mo_pts
finish
