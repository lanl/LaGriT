#####################################################################
# cp38_interp_points_tet_mo.lgi
#
# group    : interp
# expect   : valid
# spec     : interp 10 || line 10 -1.,0.,0. 1.,0.,0. 1 || line 10 0.,-1.,1. 0.,1.,1. 1
# points   : out_cp38_pts.inp
#
# WHAT:
#   the same in a TET mesh object (the usual default): only points,
#   no cells, so the same 120 points are expected.
#
# FOUND (sandbox build; FIX 1-3 = createpts_lg.f, rzbrickg.f):
#   FIXED Oct 15 2026 (createpts fixes); before: 'Grid topology too high: 3' (not an ERROR); cmo_pts empty.
#   rzbrick3.f rzinterp tests ndimensions_topo, not the cells.
#####################################################################
cmo / create / mo_tet / / / tet
createpts/line/10///-1.,0.,0.,1.,0.,0./1,1,1
createpts/line/10///0.,-1.,1.,0.,1.,1./1,1,1
createpts/ interp / 10 / 1 0 0 / 1 0 0 / mo_pts
cmo / select / mo_pts
dump / avs / out_cp38_pts.inp / mo_pts
finish
