#####################################################################
# cp03_xyz_mixed.lgi
#
# group    : xyz
# expect   : valid
# spec     : xyz 9,6,7 0.,2.,0. 5.,6.,2. 1,0,1
# points   : out_cp03_pts.inp
# mesh     : out_cp03_mesh.inp tet
# filter   : yes
#
# WHAT:
#   vertices in x and z, cell centres in y (1,0,1).
#####################################################################
cmo / create / mo_tet / / / tet
createpts / xyz / 9,6,7 / 0.,2.,0. / 5.,6.,2. / 1,0,1
dump / avs / out_cp03_pts.inp / mo_tet
cmo / setatt / mo_tet / imt / 1,0,0 / 1
filter / 1,0,0
rmpoint / compress
connect
cmo / setatt / mo_tet / itetclr / 1,0,0 / 1
resetpts / itp
quality
dump / avs / out_cp03_mesh.inp / mo_tet
finish
