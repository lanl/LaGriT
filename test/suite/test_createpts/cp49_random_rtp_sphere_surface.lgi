#####################################################################
# cp49_random_rtp_sphere_surface.lgi
#
# group    : random
# expect   : valid
# spec     : none
# points   : out_cp49_pts.inp
# mesh     : out_cp49_mesh.inp tet
# filter   : yes
# random   : rtp 0.5 5,0,0 5,180,360 0.25
#
# WHAT:
#   random points on the surface of a sphere of radius 5 (rmin = rmax
#   = 5, theta 0-180, phi 0-360), target spacing 0.5: about
#   4 pi 25 / 0.25 = 1257 points (the doc's third example, corrected).
#   Then connected: tets filling the sphere (user, Oct 16).
#####################################################################
cmo / create / mo_tet / / / tet
createpts/random/rtp/0.5/5,0,0/5,180,360/0,0,0/0.25/98765,4321
dump / avs / out_cp49_pts.inp / mo_tet
cmo / setatt / mo_tet / imt / 1,0,0 / 1
filter / 1,0,0
rmpoint / compress
connect
cmo / setatt / mo_tet / itetclr / 1,0,0 / 1
resetpts / itp
quality
dump / avs / out_cp49_mesh.inp / mo_tet
finish
