#####################################################################
# cp15_rtp_octant.lgi
#
# group    : rtp
# expect   : valid
# spec     : rtp 5,7,7 1.,0.,0. 2.,90.,90. 1,1,1
# points   : out_cp15_pts.inp
# mesh     : out_cp15_mesh.inp tet
# filter   : yes
#
# WHAT:
#   an octant of a spherical shell, r = 1 to 2, theta and phi 0 to 90.
#   The theta = 0 points of each radius coincide (the pole).
#####################################################################
cmo / create / mo_tet / / / tet
createpts / rtp / 5,7,7 / 1.,0.,0. / 2.,90.,90. / 1,1,1
dump / avs / out_cp15_pts.inp / mo_tet
cmo / setatt / mo_tet / imt / 1,0,0 / 1
filter / 1,0,0
rmpoint / compress
connect
cmo / setatt / mo_tet / itetclr / 1,0,0 / 1
resetpts / itp
quality
dump / avs / out_cp15_mesh.inp / mo_tet
finish
