#####################################################################
# cp10_rtz_arc.lgi
#
# group    : rtz
# expect   : valid
# spec     : rtz 5,7,3 1.,0.,0. 2.,90.,1. 1,1,1
# points   : out_cp10_pts.inp
# mesh     : out_cp10_mesh.inp tet
# filter   : yes
#
# WHAT:
#   a quarter annulus, r = 1 to 2, 0 to 90 deg. No duplicates. connect
#   fills the CONVEX HULL, so the cells also cover the dent at r < 1.
#####################################################################
cmo / create / mo_tet / / / tet
createpts / rtz / 5,7,3 / 1.,0.,0. / 2.,90.,1. / 1,1,1
dump / avs / out_cp10_pts.inp / mo_tet
cmo / setatt / mo_tet / imt / 1,0,0 / 1
filter / 1,0,0
rmpoint / compress
connect
cmo / setatt / mo_tet / itetclr / 1,0,0 / 1
resetpts / itp
quality
dump / avs / out_cp10_mesh.inp / mo_tet
finish
