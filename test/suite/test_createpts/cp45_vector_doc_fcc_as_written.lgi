#####################################################################
# cp45_vector_doc_fcc_as_written.lgi
#
# group    : vector
# expect   : valid
# spec     : xyz 2,2,2 .5,.5,0 0,.5,.5 0,0,0
# points   : out_cp45_pts.inp
# open     : the doc's fcc example is createpts/xyz, not createpts/vector
#
# WHAT:
#   the doc's face centred cubic example AS WRITTEN: it says
#   createpts/xyz/..., not createpts/vector/xyz/..., so LaGriT reads an
#   xyz box from (.5,.5,0) to (0,.5,.5) with switches .5,0,.5 (-> 0).
#   The same slip is in the doc's hexagonal, diamond and hcp examples.
#####################################################################
cmo / create / mo_tet / / / tet
createpts/xyz/2,2,2/.5,.5,0/0,.5,.5/.5,0,.5/
dump / avs / out_cp45_pts.inp / mo_tet
finish
