#####################################################################
# samp_U2.lgi - test U, 2D: uniform h 0.02 on the unit square, seeds 1-3
#
# Checks the Poisson disk sampler (see 00README). The facts the
# checker needs are in poisson_sampler.cases.
#####################################################################
read / avs / rect_1x1.poly / mo_polygon
cmo / select / mo_polygon
createpts / poisson_disk / 2d_polygon / mo_s1 / mo_polygon / 0.02 / no_connect &
      / poisson_seed / 1
dump / avs / out_U2_s1.inp / mo_s1
cmo / delete / mo_s1
cmo / select / mo_polygon
createpts / poisson_disk / 2d_polygon / mo_s2 / mo_polygon / 0.02 / no_connect &
      / poisson_seed / 2
dump / avs / out_U2_s2.inp / mo_s2
cmo / delete / mo_s2
cmo / select / mo_polygon
createpts / poisson_disk / 2d_polygon / mo_s3 / mo_polygon / 0.02 / no_connect &
      / poisson_seed / 3
dump / avs / out_U2_s3.inp / mo_s3
cmo / delete / mo_s3
finish
