case V2_s1 dim=2d box=0.0,0.205,0.0,10.0 h=0.01 seed=1 kind=V inp=out_V2_s1.inp deck=samp_V2.lgi field=valley:y:9:0.01:0.5:0.05
case V2_s2 dim=2d box=0.0,0.205,0.0,10.0 h=0.01 seed=2 kind=V inp=out_V2_s2.inp deck=samp_V2.lgi field=valley:y:9:0.01:0.5:0.05
