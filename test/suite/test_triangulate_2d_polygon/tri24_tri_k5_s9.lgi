#####################################################################
# tri24_tri_k5_s9.lgi
#
# polygon  : tri_k5_s9.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   triangle, 5 segments per side, list starting at vertex
#   10. The sloping sides' extra vertices are not exactly collinear
#   in binary, so the bad cell's area is tiny but not zero.
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
#   INVALID: one zero-area cell (three collinear vertices made
#   into a cell), with NO error or warning.
#####################################################################
cmo / create / mo_tri / / / triplane
read / avs / tri_k5_s9.poly / mo_tri
triangulate / counterclockwise
dump / avs / out_tri24_tri_k5_s9.inp / mo_tri
finish
