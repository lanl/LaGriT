#####################################################################
# tri22_sq_k10_mid.lgi
#
# polygon  : sq_k10_mid.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   unit square, 10 segments per side, vertex list starting
#   in the middle of a side (the start vertex matters to the bug).
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
#   INVALID: one zero-area cell (three collinear vertices made
#   into a cell), with NO error or warning.
#####################################################################
cmo / create / mo_tri / / / triplane
read / avs / sq_k10_mid.poly / mo_tri
triangulate / counterclockwise
dump / avs / out_tri22_sq_k10_mid.inp / mo_tri
finish
