#####################################################################
# tri05_spiral_sq25.lgi
#
# polygon  : spiral_sq25.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   SQUARE SPIRAL: a wall 0.3 thick wound 25 turns (202
#   vertices): long runs of reflex corners.
