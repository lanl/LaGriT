#####################################################################
# tri15_sq_k2.lgi
#
# polygon  : sq_k2.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   unit square, 2 segments per side (one extra vertex on
#   each side).
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
#   valid.
#####################################################################
cmo / create / mo_tri / / / triplane
read / avs / sq_k2.poly / mo_tri
triangulate / counterclockwise
dump / avs / out_tri15_sq_k2.inp / mo_tri
finish
