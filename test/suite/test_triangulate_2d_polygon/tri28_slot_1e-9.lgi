#####################################################################
# tri28_slot_1e-9.lgi
#
# polygon  : slot_1e-9.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   the slot's sharp tip stops 1e-9 above the bottom edge,
#   which is topologically the far side of the polygon.
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
#   FAILS: "ERROR: Unable to triangulate input".
#####################################################################
cmo / create / mo_tri / / / triplane
read / avs / slot_1e-9.poly / mo_tri
triangulate / counterclockwise
dump / avs / out_tri28_slot_1e-9.inp / mo_tri
finish
