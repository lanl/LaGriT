#####################################################################
# tri20_sq_k1000.lgi
#
# polygon  : sq_k1000.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   unit square, 1000 segments per side (4000 vertices).
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
#   INVALID: one zero-area cell (three collinear vertices made
#   into a cell), with NO error or warning.
#####################################################################
cmo / create / mo_tri / / / triplane
read / avs / sq_k1000.poly / mo_tri
triangulate / counterclockwise
dump / avs / out_tri20_sq_k1000.inp / mo_tri
finish
