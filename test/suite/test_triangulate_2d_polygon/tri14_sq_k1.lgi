#####################################################################
# tri14_sq_k1.lgi
#
# polygon  : sq_k1.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   control: the plain unit square, 4 vertices.
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
