#####################################################################
# tri29_slot_1e-8_k10.lgi
#
# polygon  : slot_1e-8_k10.poly
# expect   : valid
# picture  : small
#
# WHAT:
#   slot tip 1e-8 above the bottom edge, bottom edge split
#   into 10 segments.
#
# THE ORIGINAL CODE (before the Oct 2026 fix):
#   FAILS: "ERROR: Unable to triangulate input".
#####################################################################
cmo / create / mo_tri / / / triplane
read / avs / slot_1e-8_k10.poly / mo_tri
triangulate / counterclockwise
dump / avs / out_tri29_slot_1e-8_k10.inp / mo_tri
finish
