#####################################################################
# err22_3d_box_flat.lgi
#
# blocks   : 1
# contains : POI_ZMAX ( 0.000000E+00) must be greater than POI_ZMIN | set all six box limits
#
# EXPECT:
#   One ERROR block: the box has zero thickness in z.
#
# NOTE:
#   Before the fix the sampler aborted (free(): invalid size).
#####################################################################
define / POI_XMIN / 0.0
define / POI_YMIN / 0.0
define / POI_ZMIN / 0.0
define / POI_XMAX / 1.0
define / POI_YMAX / 1.0
define / POI_ZMAX / 0.0
define / IF_POI_EDGE_BUFFER / 1
define / POI_EDGE_BUFFER / 1.0
createpts / poisson_disk / 3d_box / mo_box_poi / 0.2 / no_connect
finish
