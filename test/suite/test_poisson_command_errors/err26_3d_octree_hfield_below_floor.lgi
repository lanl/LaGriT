#####################################################################
define / POI_XMIN / 0.0
define / POI_YMIN / 0.0
define / POI_ZMIN / 0.0
define / POI_XMAX / 1.0
define / POI_YMAX / 1.0
define / POI_ZMAX / 0.3
createpts / poisson_disk / 3d_box / mo_box_poi / 0.025 / connect &
      / hfield_vary_in_z.mlgi / h_lookup octree
finish
