# read / avs and dump / avs (avs2 and avs1) of pt cells, two vertex and two cell attributes; read the dump back
# check: finished
# check: noerror
# check: model out_pt.inp cells_pt.inp
# check: model out1_pt.inp cells_pt.inp
# check: golden out_pt.inp
# check: golden out1_pt.inp
# check: same out_pt.inp rt_pt.inp
read / avs / cells_pt.inp / mo1
dump / avs / out_pt.inp / mo1
dump / avs1 / out1_pt.inp / mo1
# read LaGriT's own file back: the same file again
read / avs / out_pt.inp / mo2
dump / avs / rt_pt.inp / mo2
finish
