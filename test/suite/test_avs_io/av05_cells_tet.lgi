# read / avs and dump / avs (avs2 and avs1) of tet cells, two vertex and two cell attributes; read the dump back
# check: finished
# check: noerror
# check: model out_tet.inp cells_tet.inp
# check: model out1_tet.inp cells_tet.inp
# check: golden out_tet.inp
# check: golden out1_tet.inp
# check: same out_tet.inp rt_tet.inp
read / avs / cells_tet.inp / mo1
dump / avs / out_tet.inp / mo1
dump / avs1 / out1_tet.inp / mo1
# read LaGriT's own file back: the same file again
read / avs / out_tet.inp / mo2
dump / avs / rt_tet.inp / mo2
finish
