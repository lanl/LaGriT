# st06_2d.lgi -- test_stor_utm (see 00README)
# a 2D triangle mesh, 41 x 31 lattice in a 0.04 x 0.03 rectangle (cells
# about 1e-3), interior vertices moved; dump / stor (2D: matbld2d_stor)
cmo / create / mo_box / / / triplane
createpts / xyz / 41 31 1 / 0. 0. 0. / 0.04 0.03 0. / 1 1 1
cmo / setatt / mo_box / imt / 1 0 0 / 1
connect
resetpts / itp
pset / p_in / attribute / itp / 1 0 0 / eq / 0
perturb / pset get p_in / 0.0003 0.0003 0.
connect
resetpts / itp
# The same mesh at the origin and at UTM coordinates: move it out and
# back (x - 7e5 is exact there), so both copies have the same geometry
# to the last bit, then write it; move it out again and write it again.
trans / 1 0 0 / 0. 0. 0. / 700000. 3200000. 1500.
trans / 1 0 0 / 0. 0. 0. / -700000. -3200000. -1500.
dump / avs / st06_mesh.inp / mo_box
dump / stor / st06_o / mo_box
trans / 1 0 0 / 0. 0. 0. / 700000. 3200000. 1500.
dump / stor / st06_u / mo_box
finish
