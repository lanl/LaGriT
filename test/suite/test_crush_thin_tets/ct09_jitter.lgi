# ct09_jitter.lgi
# The lattice with every vertex moved at random (up to 0.4; seed 7):
# thin tets of every kind: every vertex of the regular lattice tet
# mesh (6 x 6 x 6 vertices, 750 tets) moved at random by
# make_inputs.py; every tet stays valid. crush_thin_tets at its
# default TOLCRUSH 0.1. Each written mesh is also measured
# (ct_measure.mlgi: Carl Gable's dihedral, solid angle and edge ratio
# attributes) into <name>_m.inp.
# expect: measured
# check: crush | ct09 | jitter.inp | 0.1
read / avs / jitter.inp / mo_tet
resetpts / itp
dump / avs / ct09_before.inp / mo_tet
define / MO / mo_tet
define / AVS_OUT / ct09_before_m.inp
infile ct_measure.mlgi
crush_thin_tets / mo_tet / 0.1
rmpoint / compress
resetpts / itp
dump / avs / ct09_after_0.1.inp / mo_tet
define / MO / mo_tet
define / AVS_OUT / ct09_after_0.1_m.inp
infile ct_measure.mlgi
finish
