# ct03_cap_interior.lgi
# A CAP (a vertex close to the middle of its opposite face) inside the
# mesh: one vertex of a regular lattice tet mesh (6 x 6 x 6 vertices,
# 750 tets, relative width 0.41 everywhere) moved by make_inputs.py;
# every tet stays valid. crush_thin_tets at its default TOLCRUSH 0.1.
# Each written mesh is also measured (ct_measure.mlgi: Carl Gable's
# dihedral, solid angle and edge ratio attributes) into <name>_m.inp.
# expect: measured: the CAP case is switched off in
#   crush_thin_tets.f (if (.false.) around find_02), so the cap can
#   only go as a side effect; moving one vertex to make a cap always
#   makes a thin neighbour (a sliver), whose collapse removes the cap
#   too
# check: crush | ct03 | cap_interior.inp | 0.1
read / avs / cap_interior.inp / mo_tet
resetpts / itp
dump / avs / ct03_before.inp / mo_tet
define / MO / mo_tet
define / AVS_OUT / ct03_before_m.inp
infile ct_measure.mlgi
crush_thin_tets / mo_tet / 0.1
rmpoint / compress
resetpts / itp
dump / avs / ct03_after_0.1.inp / mo_tet
define / MO / mo_tet
define / AVS_OUT / ct03_after_0.1_m.inp
infile ct_measure.mlgi
finish
