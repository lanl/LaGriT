# d12_exclude_hole.lgi -- test_cv_dual_dump_keyword (see 00README)
# a planned hole: the cube 1.2 x 1.2 x 1.2 with the cube
# 0.4 to 0.8 cut out of its middle, as a conforming Voronoi mesh:
# generators at the centers of a 6 x 6 x 6 grid of cubes, ghosts
# (material 2) mirrored outside the six sides AND inside the hole (the
# 8 cells there). dump / fehm with exclude, 2: the faces shared with
# the ghosts make 2 closed pieces, the outside (area 8.64) and the
# hole's walls (0.96); kept volume 1.664.
cmo / create / mo / / / tet
createpts / xyz / 8 8 8 / -0.1 -0.1 -0.1 / 1.3 1.3 1.3 / 1 1 1
cmo / setatt / mo / imt / 1 0 0 / 1
cmo / setatt / mo / itp / 1 0 0 / 0
connect
resetpts / itp
pset / pg1 / attribute / xic / 1 0 0 / lt 0.
pset / pg2 / attribute / xic / 1 0 0 / gt 1.2
pset / pg3 / attribute / yic / 1 0 0 / lt 0.
pset / pg4 / attribute / yic / 1 0 0 / gt 1.2
pset / pg5 / attribute / zic / 1 0 0 / lt 0.
pset / pg6 / attribute / zic / 1 0 0 / gt 1.2
pset / ph1 / attribute / xic / 1 0 0 / gt 0.4
pset / ph2 / attribute / xic / 1 0 0 / lt 0.8
pset / ph3 / attribute / yic / 1 0 0 / gt 0.4
pset / ph4 / attribute / yic / 1 0 0 / lt 0.8
pset / ph5 / attribute / zic / 1 0 0 / gt 0.4
pset / ph6 / attribute / zic / 1 0 0 / lt 0.8
pset / ph / inter / ph1 ph2 ph3 ph4 ph5 ph6
pset / pg / union / pg1 pg2 pg3 pg4 pg5 pg6 ph
cmo / setatt / mo / imt / pset get pg / 2
dump / avs / mesh.inp / mo
dump / fehm / f_ex / mo / exclude, 2
dump / avs / after.inp / mo
finish
